{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anastylos.invalid/blueprint/cad-feature-model-v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cad-feature-model-v1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_model_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "units": {
      "const": "mm"
    },
    "T_CAD_B": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "units": {
          "const": "mm"
        },
        "matrix": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 16,
          "maxItems": 16
        }
      },
      "required": [
        "from",
        "to",
        "units",
        "matrix"
      ],
      "additionalProperties": false
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "feature_id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "box"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "size_mm": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1000
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "size_mm"
                ],
                "additionalProperties": false
              },
              "basis": {
                "enum": [
                  "geometric_measurement",
                  "operator_testimony",
                  "model_assumption"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "uncertainty_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "assumptions": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "T_CAD_feature": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "units": {
                    "const": "mm"
                  },
                  "matrix": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 16,
                    "maxItems": 16
                  }
                },
                "required": [
                  "from",
                  "to",
                  "units",
                  "matrix"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "feature_id",
              "kind",
              "parameters",
              "basis",
              "evidence_ids",
              "uncertainty_mm",
              "assumptions",
              "T_CAD_feature"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "feature_id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "cylinder"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "radius_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  "height_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  }
                },
                "required": [
                  "radius_mm",
                  "height_mm"
                ],
                "additionalProperties": false
              },
              "basis": {
                "enum": [
                  "geometric_measurement",
                  "operator_testimony",
                  "model_assumption"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "uncertainty_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "assumptions": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "T_CAD_feature": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "units": {
                    "const": "mm"
                  },
                  "matrix": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 16,
                    "maxItems": 16
                  }
                },
                "required": [
                  "from",
                  "to",
                  "units",
                  "matrix"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "feature_id",
              "kind",
              "parameters",
              "basis",
              "evidence_ids",
              "uncertainty_mm",
              "assumptions",
              "T_CAD_feature"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "feature_id": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "through_hole"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "radius_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  "depth_mm": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1000
                  },
                  "parent_feature_id": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": [
                  "radius_mm",
                  "depth_mm",
                  "parent_feature_id"
                ],
                "additionalProperties": false
              },
              "basis": {
                "enum": [
                  "geometric_measurement",
                  "operator_testimony",
                  "model_assumption"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "uncertainty_mm": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "assumptions": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "T_CAD_feature": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "units": {
                    "const": "mm"
                  },
                  "matrix": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 16,
                    "maxItems": 16
                  }
                },
                "required": [
                  "from",
                  "to",
                  "units",
                  "matrix"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "feature_id",
              "kind",
              "parameters",
              "basis",
              "evidence_ids",
              "uncertainty_mm",
              "assumptions",
              "T_CAD_feature"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "model_id",
    "revision",
    "parent_model_sha256",
    "dataset_sha256",
    "units",
    "T_CAD_B",
    "features"
  ],
  "additionalProperties": false,
  "$comment": "PROPOSED CAD-2 minimum. Semantic validator rejects nonfinite numbers,  invalid transforms, unknown refs, dependency cycles and unsupported booleans before trusted compilation. Slots, extruded profiles, lofts and assemblies require explicitly versioned extensions; no arbitrary Python."
}
