<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared up front, requested contextually at the moment of use. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Opt-in "Listen for Muse" voice mode only; requested when switched on. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- LAN HTTPS to the workstation is a socket like any other. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 16+ local-network access policy; ignored on older platforms. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:name=".di.CaptureApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnastylosCapture">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AnastylosCapture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
