# Auto detect text files and perform LF normalization
* text=auto

*.py text eol=lf
*.svg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf

*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary


# Preserve exact microscopy delivery and historical QA hashes.
anastylos-microscopy/** -text
